{
  "name": "@gateflow/sim-cli",
  "version": "0.7.0",
  "private": true,
  "description": "Command-line interface for GateFlow simulation experiments (gateflow-sim).",
  "type": "module",
  "bin": {
    "gateflow-sim": "./dist/gateflow-sim.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --testTimeout=60000 --hookTimeout=60000"
  },
  "dependencies": {
    "@gateflow/domain": "workspace:*",
    "@gateflow/priority-engine": "workspace:*",
    "@gateflow/queue-core": "workspace:*",
    "@gateflow/sim-kernel": "workspace:*",
    "@gateflow/sim-metrics": "workspace:*",
    "@gateflow/sim-model": "workspace:*",
    "@gateflow/sim-scenarios": "workspace:*",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
