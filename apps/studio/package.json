{
  "name": "@gateflow/studio",
  "version": "0.9.0",
  "private": true,
  "description": "GateFlow Simulator Studio: the simulator in the browser, as one self-contained HTML page.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --testTimeout=60000 --hookTimeout=60000",
    "test:e2e": "vitest run --config vitest.e2e.config.mjs"
  },
  "dependencies": {
    "@gateflow/queue-core": "workspace:*",
    "@gateflow/sim-metrics": "workspace:*",
    "@gateflow/sim-scenarios": "workspace:*",
    "@gateflow/studio-core": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@gateflow/sim-cli": "workspace:*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0"
  }
}
