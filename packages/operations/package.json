{
  "name": "@gateflow/operations",
  "version": "0.3.0",
  "private": true,
  "description": "The operational checkpoint: one service day of a checkpoint run on the simulator's queue, commands in, events out, rebuilt exactly from its command log (pure).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.src.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --testTimeout=300000 --hookTimeout=300000"
  },
  "dependencies": {
    "@gateflow/domain": "workspace:*",
    "@gateflow/priority-engine": "workspace:*",
    "@gateflow/queue-core": "workspace:*"
  }
}
