{
  "name": "@gateflow/sim-trace",
  "version": "0.1.0",
  "private": true,
  "description": "The trace of one simulated day: every event of two policies on the same passengers, the replay, each passenger's journey and the explanation of every call (pure).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.src.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --testTimeout=120000 --hookTimeout=120000"
  },
  "dependencies": {
    "@gateflow/domain": "workspace:*",
    "@gateflow/priority-engine": "workspace:*",
    "@gateflow/queue-core": "workspace:*",
    "@gateflow/sim-kernel": "workspace:*",
    "@gateflow/sim-metrics": "workspace:*",
    "@gateflow/sim-model": "workspace:*",
    "@gateflow/sim-scenarios": "workspace:*"
  }
}
