{
  "name": "@gateflow/studio-core",
  "version": "0.2.0",
  "private": true,
  "description": "Logic of GateFlow Simulator Studio that runs in the browser: scenario library, hashing, editing, experiment setup, comparison of runs and the traces of days (pure).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.src.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --testTimeout=300000 --hookTimeout=300000"
  },
  "dependencies": {
    "@gateflow/queue-core": "workspace:*",
    "@gateflow/sim-metrics": "workspace:*",
    "@gateflow/sim-scenarios": "workspace:*",
    "@gateflow/sim-trace": "workspace:*"
  }
}
