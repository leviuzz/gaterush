{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["scenarios/**", "tsconfig.base.json", "eslint.config.js"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build", "transit"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    }
  }
}
